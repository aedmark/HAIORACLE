{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Whimsy Machine",
  "version": "1.0.0",
  "identifier": "com.aedmark.whimsy-machine",
  "build": {
    "beforeBuildCommand": "node tools/stage_tauri_dist.mjs",
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "title": "The Whimsy Machine",
        "width": 1200,
        "height": 900,
        "minWidth": 380,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
